void generate(int arr[], int n, int i, int subset[], int size) {  //subset[100], generate(arr, n, 0, subset, 0)
    if(i == n) { 
        for(int j=0; j< size; j++) cout << subset[j] << " ";      // foreach loop wont work in subset, bcz its array.
        return;                                                   // become pointer when pass. thats why used size variable
    } 
    generate(arr, n, i+1, subset, size); 
    subset[size] = arr[i];
    generate(arr, n, i+1, subset, size+1);
} 
                       
