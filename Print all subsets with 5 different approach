void generate(vector<int>& arr, int i, vector<int>& subset) {   //vector<int> subset; i = 0
    if(i == arr.size()) { 
        for(int x : subset) cout << x << " "; 
        return;
    } 
    generate(arr, i+1, subset); 
    subset.push_back(arr[i]);
    generate(arr, i+1, subset);
    subset.pop_back();
} 
