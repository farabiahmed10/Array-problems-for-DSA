    int n = arr.size();
    int totalOnes = count(arr.begin(), arr.end(), 1);
    if(totalOnes == 0) return -1;
    int windowSize = totalOnes;
    int currOnes = 0; 
    for(int i = 0; i < windowSize; i++) {
        if(arr[i] == 1) currOnes++;
    }
    int maxOnes = currOnes; 
    for(int i = windowSize; i < n; i++) {
        if(arr[i] == 1) currOnes++;
        if(arr[i - windowSize] == 1) currOnes--;
        maxOnes = max(maxOnes, currOnes);
    }
    return totalOnes - maxOnes;
